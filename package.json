{
  "name": "more-firepower",
  "version": "0.12.0",
  "type": "module",
  "dependencies": {
    "@playwright/test": "^1.62.0",
    "express": "^4.19.0",
    "three": "^0.165.0",
    "ws": "^8.18.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:frontier": "node server/index.js --map frontier_corridor",
    "start:riverline": "node server/index.js --map riverline",
    "start:blackwood": "node server/index.js --map blackwood",
    "start:sawtooth": "node server/index.js --map sawtooth",
    "start:caldera": "node server/index.js --map caldera",
    "pick": "node tools/pick_map.mjs",
    "maps": "node server/index.js --list-maps",
    "sim1f": "node test/headless/sim1f.js",
    "sim1g": "node test/headless/sim1g.js",
    "sim2a": "node test/headless/sim2a.js",
    "strip": "node tools/render_asset_strip.mjs",
    "sprites": "node tools/bake_sprites.mjs",
    "simwar": "node test/headless/sim_standard_war.js",
    "simv1": "node -e \"import('./test/headless/soak_v1.js').then(({runV1Soak})=>{const r=runV1Soak(2026,3000);console.log(JSON.stringify({activeOperators:r.activeOperators,captures:r.captures,disables:r.disables,replayOk:r.liveHash===r.replayHash,ticksPerSecond:r.ticksPerSecond,scores:r.server.state.teamScores},null,1))})\"",
    "test": "node --test --test-concurrency=4 test/*.test.js"
  },
  "license": "MIT",
  "description": "Fireline Command \u2014 join the battle, turn the front. A deterministic, server-authoritative tactical wargame (new IP)."
}
